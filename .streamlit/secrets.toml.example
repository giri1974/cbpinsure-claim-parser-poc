# Paste one of these (with real values) into Streamlit Cloud -> App -> Settings -> Secrets.
# Never commit the real secrets.toml.

# --- Option A: cloud Postgres (Neon / Render) - recommended for hosted deployment ---
[postgres]
url = "postgresql://USER:PASSWORD@HOST/DBNAME"
# or discrete keys instead of url:
# server   = "HOST"
# port     = 5432
# database = "DBNAME"
# user     = "USER"
# password = "PASSWORD"

# --- Option B: cloud SQL Server (only if you host your own reachable MS SQL) ---
# [cloud]
# server   = "your-sql-host"
# port     = 1433
# database = "yourdb"
# user     = "youruser"
# password = "yourpassword"
